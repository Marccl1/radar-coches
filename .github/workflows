name: Rastreo diario

on:
  schedule:
    - cron: "30 5 * * *"   # 05:30 UTC = 07:30 en verano / 06:30 en invierno (Madrid)
  workflow_dispatch:        # botón "Run workflow" para lanzarlo a mano

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: rastreo
  cancel-in-progress: false

jobs:
  rastrear:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    environment:
      name: github-pages
      url: ${{ steps.deploy.outputs.page_url }}
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      # El histórico de precios (para detectar bajadas y anuncios nuevos) vive en la caché
      - uses: actions/cache/restore@v4
        with:
          path: data
          key: historial-${{ github.run_id }}
          restore-keys: historial-

      - name: Rastrear
        run: python rastreador.py

      - uses: actions/cache/save@v4
        if: success()
        with:
          path: data
          key: historial-${{ github.run_id }}

      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: docs
      - id: deploy
        uses: actions/deploy-pages@v4
